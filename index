<p class="p1"><span class="Apple-converted-space">        </span>}</p>
<p class="p1"><span class="Apple-converted-space">      </span>}, intervalTime);</p>
<p class="p1"><span class="Apple-converted-space">    </span>}</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">    </span>// Hiển thị Popup kết quả</p>
<p class="p1"><span class="Apple-converted-space">    </span>function showWinner(student) {</p>
