<p class="p1"><span class="Apple-converted-space">    </span>// Hiệu ứng Quay Gọi Tên</p>
<p class="p1"><span class="Apple-converted-space">    </span>function startSpin() {</p>
<p class="p1"><span class="Apple-converted-space">      </span>if (students.length === 0) return alert("Hết học sinh để quay!");</p>
<p class="p2"><span class="Apple-converted-space">      </span></p>
<p class="p1"><span class="Apple-converted-space">      </span>const btn = document.getElementById('spin-btn');</p>
<p class="p1"><span class="Apple-converted-space">      </span>btn.disabled = true;</p>
<p class="p1"><span class="Apple-converted-space">      </span>btn.classList.add('opacity-50');</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">      </span>const duration = parseInt(document.getElementById('spin-duration').value) * 1000;</p>
<p class="p1"><span class="Apple-converted-space">      </span>const intervalTime = 100;</p>
<p class="p1"><span class="Apple-converted-space">      </span>let elapsed = 0;</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">      </span>const interval = setInterval(() =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">        </span>document.querySelectorAll('.student-card').forEach(c =&gt; {</p>
<p class="p1"><span class="Apple-converted-space">          </span>c.classList.remove('border-indigo-600', 'bg-indigo-50', 'ring-2', 'ring-indigo-400', 'scale-105');</p>
<p class="p1"><span class="Apple-converted-space">        </span>});</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">        </span>const randomIndex = Math.floor(Math.random() * students.length);</p>
<p class="p1"><span class="Apple-converted-space">        </span>const selected = students[randomIndex];</p>
<p class="p1"><span class="Apple-converted-space">        </span>const card = document.getElementById(`card-${selected.id}`);</p>
<p class="p1"><span class="Apple-converted-space">        </span>if(card) {</p>
<p class="p1"><span class="Apple-converted-space">          </span>card.classList.add('border-indigo-600', 'bg-indigo-50', 'ring-2', 'ring-indigo-400', 'scale-105');</p>
<p class="p1"><span class="Apple-converted-space">        </span>}</p>
<p class="p2"><br></p>
<p class="p1"><span class="Apple-converted-space">        </span>elapsed += intervalTime;</p>
<p class="p1"><span class="Apple-converted-space">        </span>if (elapsed &gt;= duration) {</p>
<p class="p1"><span class="Apple-converted-space">          </span>clearInterval(interval);</p>
<p class="p1"><span class="Apple-converted-space">          </span>currentWinner = selected;</p>
